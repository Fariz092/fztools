rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidConversionHistory(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'toolType', 'title', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'toolType', 'title', 'details', 'previewUrl', 'fileFormat', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId &&
        data.toolType is string && data.toolType.size() > 0 && data.toolType.size() <= 64 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('details' in data) || (data.details is string && data.details.size() <= 4096)) &&
        (!('previewUrl' in data) || (data.previewUrl is string && data.previewUrl.size() <= 204800)) &&
        (!('fileFormat' in data) || (data.fileFormat is string && data.fileFormat.size() <= 32));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(userId) && isOwner(userId);

      match /history/{historyId} {
        allow get: if isValidId(userId) && isValidId(historyId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(historyId) && isOwner(userId) &&
          isValidConversionHistory(incoming(), userId) &&
          incoming().id == historyId &&
          incoming().userId == userId;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(historyId) && isOwner(userId);
      }
    }
  }
}
